# Copy this file to server/.env and adjust the values.

NODE_ENV=development
PORT=4000

# Works both with docker-compose and with a local PostgreSQL prepared
# via scripts/init-local-db.sql
DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban_dev?schema=public"

# Separate database for the test suite: it truncates tables between test cases
TEST_DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban_test?schema=public"

# Secret used to sign access tokens. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-secret-change-me-in-production"

# Client origin: used for CORS
CLIENT_URL="http://localhost:5173"

# lax  — client and API share a site (local development)
# none — client and API live on different sites (Vercel + Render); requires HTTPS
COOKIE_SAMESITE=lax

# true — the server sits behind a reverse proxy (Render, Fly, nginx);
# without it secure cookies are not set
TRUST_PROXY=false
